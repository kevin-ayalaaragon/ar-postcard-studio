# Copy to .env for local dev.

# Postgres (Neon). Both dev and prod point at Neon - a free branch per
# environment, no local Postgres server required. DATABASE_URL is the
# pooled connection (PgBouncer) the app queries through; DIRECT_URL is
# the unpooled connection Prisma Migrate needs. Neon's dashboard gives you
# both for the same database - see docs/adr/0009-single-postgres-datasource.md
# and docs/adr/0010-hosting-vercel-neon-b2.md.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Shared-secret header value the admin asset-upload endpoint checks for.
# MVP-only stand-in for real auth - see docs/adr/0007-admin-auth.md.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Base URL used to build the QR code / viewer links baked into each
# postcard's print files. Point this at the deployed origin in prod.
PUBLIC_BASE_URL="http://localhost:3000"

# Where uploaded/generated files live.
#
# Option A - local dev, no account needed: leave the four B2_* vars below
# unset and set LOCAL_STORAGE_DIR. Files land in that local folder.
#
# Option B - Backblaze B2 (used automatically once B2_KEY_ID is set,
# takes priority over LOCAL_STORAGE_DIR): see
# docs/adr/0006-file-storage.md and docs/adr/0010-hosting-vercel-neon-b2.md.
# B2_REGION is shown on the bucket's own page in the B2 dashboard (e.g.
# "us-west-004") - a B2 account is pinned to one region.
LOCAL_STORAGE_DIR="./storage"
# B2_KEY_ID="from a non-master B2 application key"
# B2_APPLICATION_KEY="from the same application key"
# B2_BUCKET_NAME="ar-postcard-studio"
# B2_REGION="us-west-004"
